# Copy to .env.local (never commit real secrets).

# ---- Site ----
# Public URL of the live site, no trailing slash. Used in the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" ONLY on the live production site to allow search engines to index it.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Set to "true" to show media slot ids on photo placeholders in a production review build.
NEXT_PUBLIC_SHOW_MEDIA_SLOTS=false

# ---- Payments ----
# "demo" (default): no money moves. "stripe": live/sandbox Stripe Checkout.
PAYMENT_PROVIDER=demo
# Stripe keys (use sk_test_... / whsec_... for sandbox testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where payment records are stored (JSON file store). Must be persistent and private.
DATA_DIR=./data

# ---- Contact form (Resend) ----
RESEND_API_KEY=
# Comma-separated list of recipients for website enquiries.
CONTACT_TO_EMAIL=
# A sender on a domain verified with Resend, e.g. "Al-Falah Website <website@your-domain>".
CONTACT_FROM_EMAIL=
